  </div>
</section>

<!-- ===== УСЛОВИЯ ===== -->
<section id="conditions">
  <div class="container">
    <h2 class="section-title fade-up"><span class="badge bg-success rounded-pill me-2" style="font-size:0.7em;"><i class="bi bi-person-check"></i></span>Условия участия</h2>
    <div class="card-custom p-4 fade-up">
      <ul class="mb-3">
        {% for c in argentinaTrip2026.conditions %}<li>{{ c }}</li>{% endfor %}
      </ul>
      <p class="mb-0"><i class="bi bi-envelope me-1"></i>Чтобы узнать стоимость и задать вопросы, воспользуйтесь контактами bsgro внизу страницы.</p>
    </div>
  </div>
</section>

<script src="/assets/vendor/leaflet/leaflet.js"></script>
<script>
(function () {
  var TRIP = {{ argentinaTrip2026 | dump | safe }};
  var live = document.getElementById('arLive');
  var stopsById = {}, airportsByCode = {}, markers = {}, current = null, timer = null;
  TRIP.stops.forEach(function (s) { stopsById[s.id] = s; });
  /* Размер попапа по размеру карты: на телефоне длинный текст прокручивается внутри, а не обрезается */
  function popupOpts() {
    var sz = map.getSize();
    return { maxWidth: Math.max(180, Math.min(320, sz.x - 50)), maxHeight: Math.max(110, sz.y - 120), autoPanPaddingTopLeft: [12, 12], autoPanPaddingBottomRight: [12, 12] };
  }
  TRIP.airports.forEach(function (a) { airportsByCode[a.code] = a; });

  function rowEl(id) { return document.getElementById('row-' + id); }
  function inView(el) { var r = el.getBoundingClientRect(); return r.top >= 70 && r.bottom <= window.innerHeight; }
  function say(t) { if (live) { live.textContent = ''; live.textContent = t; } }

  function highlight(id, scroll) {
    var el = rowEl(id); if (!el) return;
    document.querySelectorAll('#arMapTable tr.is-active, #arAirports li.is-active').forEach(function (e) { e.classList.remove('is-active'); });
    el.classList.add('is-active');
    clearTimeout(timer);
    timer = setTimeout(function () { el.classList.remove('is-active'); }, 3000);
    if (scroll) {
      el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      try { history.replaceState(null, '', '#row-' + id); } catch (e) {}
    }
  }

  function popupFor(s) {
    var d = document.createElement('div'); d.className = 'ar-popup';
    var h = document.createElement('strong'); h.textContent = s.n + '. ' + s.name; d.appendChild(h);
    [s.dates, s.place].forEach(function (t) { var p = document.createElement('div'); p.textContent = t; d.appendChild(p); });
    var ul = document.createElement('ul');
    s.whatWeDo.forEach(function (w) { var li = document.createElement('li'); li.textContent = w; ul.appendChild(li); });
    d.appendChild(ul);
    return d;
  }

  if (typeof L === 'undefined' || !document.getElementById('arMap')) return;

  var map = L.map('arMap', { keyboard: true, scrollWheelZoom: false });
  map.attributionControl.setPrefix(false);
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 18,
    attribution: '© участники <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
  }).addTo(map);

  function ll(p) { return [p.lat, p.lon]; }
  function bow(a, b) {
    var m = [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2], dx = b[1] - a[1], dy = b[0] - a[0];
    return [a, [m[0] + dx * 0.06, m[1] - dy * 0.06], b];
  }

  // перелёты
  TRIP.flightSegments.forEach(function (f) {
    var a = ll(airportsByCode[f.from]), b = ll(airportsByCode[f.to]);
    var pts = f.dashed ? bow(a, b) : [a, b];
    var opt = { color: '#1f6feb', weight: 3 };
    if (f.dashed) opt.dashArray = '6 8';
    L.polyline(pts, opt).addTo(map).bindTooltip(f.from + ' → ' + f.to + (f.dashed ? ' (маршрут уточняется)' : ''), { sticky: true });
  });

  // наземный маршрут
  var path = TRIP.groundRoute.map(function (r) { return r.ref ? ll(stopsById[r.ref]) : [r.lat, r.lon]; });
  L.polyline(path, { color: '#d62828', weight: 3 }).addTo(map);

  // аэропорты
  TRIP.airports.forEach(function (a) {
    var m = L.marker(ll(a), {
      keyboard: true, title: a.name + ' (' + a.code + ')', alt: a.name,
      icon: L.divIcon({ className: '', html: '<div class="ar-airport" data-code="' + a.code + '">' + a.code + '</div>', iconSize: [38, 20], iconAnchor: [19, 10] })
    }).addTo(map);
    m.bindPopup(a.name + ' (' + a.code + '): ' + a.note, popupOpts());
    m.on('click', function () { selectAirport(a.code, { fromMap: true }); });
    markers['airport-' + a.code] = m;
  });

  // остановки
  TRIP.stops.forEach(function (s) {
    var m = L.marker(ll(s), {
      keyboard: true, title: s.n + '. ' + s.name, alt: s.name, zIndexOffset: 500,
      icon: L.divIcon({ className: '', html: '<div class="ar-marker" data-id="' + s.id + '">' + s.n + '</div>', iconSize: [30, 30], iconAnchor: [15, 15] })
    }).addTo(map);
    m.bindPopup(popupFor(s), popupOpts());
    m.on('click', function () { selectStop(s.id, { fromMap: true }); });
    markers[s.id] = m;
  });

  function setMarkerActive(key) {
    document.querySelectorAll('#arMap .is-active').forEach(function (e) { e.classList.remove('is-active'); });
    if (!key) return;
    var el = markers[key] && markers[key].getElement();
    var inner = el && el.firstChild;
    if (inner) inner.classList.add('is-active');
    current = key;
  }

  function showOnMap(key, latlng, zoom, opts) {
    var mapEl = document.getElementById('arMap');
    if (!opts.fromMap && !opts.noScroll && !inView(mapEl)) mapEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    var z = Math.max(map.getZoom(), zoom);
    var c = map.getCenter();
    var already = map.getZoom() >= z && Math.abs(c.lat - latlng[0]) + Math.abs(c.lng - latlng[1]) < 0.01;
    map.closePopup();
    setMarkerActive(key);
    if (already) { markers[key].openPopup(); return; }
    /* попап открываем после полёта: тогда автопрокрутка карты учитывает его высоту */
    map.once('moveend', function () { markers[key].openPopup(); });
    map.flyTo(latlng, z);
  }

  function selectStop(id, opts) {
    opts = opts || {};
    var s = stopsById[id]; if (!s) return;
    showOnMap(id, ll(s), 7, opts);
    highlight(id, !!opts.fromMap);
    say('Показана точка ' + s.n + ': ' + s.name);
  }

  function selectAirport(code, opts) {
    opts = opts || {};
    var a = airportsByCode[code]; if (!a) return;
    showOnMap('airport-' + code, ll(a), 7, opts);
    highlight('airport-' + code, !!opts.fromMap);
    say('Показан аэропорт ' + code + ': ' + a.name);
  }

  function bindRow(el, fn) {
    el.addEventListener('click', function () { fn(); });
    el.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') { e.preventDefault(); fn(); }
    });
  }
  document.querySelectorAll('#arMapTable tr[data-stop]').forEach(function (tr) { bindRow(tr, function () { selectStop(tr.getAttribute('data-stop')); }); });
  document.querySelectorAll('#arAirports li[data-airport]').forEach(function (li) { bindRow(li, function () { selectAirport(li.getAttribute('data-airport')); }); });

  try {
    var pts = path.concat(TRIP.airports.map(ll));
    map.fitBounds(L.latLngBounds(pts).pad(0.1));
  } catch (e) { map.setView([-35, -60], 5); }
  setTimeout(function () { map.invalidateSize(); }, 200);

  window.arMapApi = { map: map, markers: markers, selectStop: selectStop, selectAirport: selectAirport };

  var m = /^#row-(stop-\d+)$/.exec(location.hash);
  if (m && stopsById[m[1]]) selectStop(m[1], { noScroll: true });
})();
</script>

</div>
