{# ===== NAVBAR ===== #}
<nav class="navbar navbar-expand-lg sticky-top">
  <div class="container">

    {# --- Brand / Logo --- #}
    {% if pageId == "index" %}
      <a class="navbar-brand" href="#top"><img src="/assets/logo.png" alt="Центр компетенций БСГРО / BSGRO" loading="lazy"></a>
    {% else %}
      <a class="navbar-brand" href="/"><img src="/assets/logo.png" alt="Центр компетенций БСГРО / BSGRO" loading="lazy"></a>
    {% endif %}

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent" aria-label="Навигация">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navContent">
      <ul class="navbar-nav ms-auto me-3">

        {# ===== Единое меню из nav.json ===== #}
        {% for item in nav.main %}
          {% if item.dropdown %}
            {% set isActive = false %}
            {% for child in item.children %}{% if child.pageId and child.pageId == pageId %}{% set isActive = true %}{% endif %}{% endfor %}
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle{% if isActive %} active{% endif %}" href="#" role="button" data-bs-toggle="dropdown">{{ item.label }}</a>
              <ul class="dropdown-menu">
                {% for child in item.children %}
                  {% if child.type == "divider" %}
                    <li><hr class="dropdown-divider"></li>
                  {% elif child.type == "header" %}
                    <li><h6 class="dropdown-header">{{ child.label }}</h6></li>
                  {% else %}
                    <li><a class="dropdown-item{% if pageId == child.pageId %} active{% endif %}" href="{{ child.url }}">{% if child.icon %}<i class="bi {{ child.icon }} me-2"></i>{% endif %}{{ child.label }}</a></li>
                  {% endif %}
                {% endfor %}
              </ul>
            </li>
          {% else %}
            <li class="nav-item">
              <a class="nav-link{% if pageId == item.pageId %} active{% endif %}" href="{{ item.url }}">{% if item.icon %}<i class="bi {{ item.icon }} me-1"></i>{% endif %}{{ item.label }}</a>
            </li>
          {% endif %}
        {% endfor %}

        {# Якоря секций новой главной #}
        {% if pageId == "index" %}
          {% for sec in nav.indexSections %}
            <li class="nav-item"><a class="nav-link" href="{{ sec.anchor }}">{{ sec.label }}</a></li>
          {% endfor %}
        {% endif %}
      </ul>

      {# --- Language switch --- #}
      <div class="lang-switch d-none d-lg-block">
        {% for lang in site.langs %}
          {% if lang == site.activeLang %}
            <span class="active-lang">{{ lang }}</span>
          {% else %}
            <span class="disabled-lang">{{ lang }}</span>
          {% endif %}
          {% if not loop.last %} | {% endif %}
        {% endfor %}
      </div>

    </div>
  </div>
</nav>
