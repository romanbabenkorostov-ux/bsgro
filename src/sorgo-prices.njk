---
layout: base.njk
pageId: "sorgo-prices"
pageTitle: "BSGRO — Цены на сорго: Texas FOB и США (фермеры)"
pageDescription: "Цены на сорго по задокументированным источникам: Texas FOB (индикативные недельные котировки), США — цена фермерам (USDA NASS). Период до сентября 2026, последняя доступная точка — 2026-08-29."
pageKeywords: "сорго, цены, Texas FOB, USDA NASS, график, сельское хозяйство, USD, метрическая тонна"
footerGroup: "sorgo"
permalink: "/sorgo-prices/"
---
{% set typeRu = {
  "commercial_indicative_quotes": "коммерческие индикативные котировки",
  "official_statistics": "официальная статистика",
  "commercial_primary_publication": "коммерческая публикация",
  "secondary_republisher": "вторичный републикатор",
  "reference_definition": "справочное определение"
} %}

<!-- ===== HERO ===== -->
<section class="hero" id="hero" style="padding:5rem 0 3rem; background: linear-gradient(135deg, #061D33 0%, #0D3B66 40%, #1B5E20 100%); color:#fff;">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-10">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb mb-2" style="background:transparent;padding:0;">
            <li class="breadcrumb-item"><a href="/" style="color:var(--clr-lime);">Главная</a></li>
            <li class="breadcrumb-item"><a href="/sorgo-project/#strategy" style="color:var(--clr-lime);">Стратегия</a></li>
            <li class="breadcrumb-item active" style="color:rgba(255,255,255,0.7);">Цены на сорго</li>
          </ol>
        </nav>
        <h1 style="font-size:clamp(1.6rem,3.5vw,2.4rem);">
          <i class="bi bi-graph-up-arrow me-2"></i>Цены на сорго: Texas FOB и США
        </h1>
        <p class="mb-0" style="opacity:0.85; max-width:760px;">
          Период: {{ sorghumPrices.meta.periodStart }} … {{ sorghumPrices.meta.periodEnd }} (последняя доступная точка — {{ sorghumPrices.meta.lastAvailablePoint }})&ensp;·&ensp;USD за метрическую тонну<br>
          Источники: <strong>MOST Agro</strong> (Texas FOB, индикативные котировки) и <strong>USDA NASS</strong> (цена, полученная фермерами США). Ряды разнородны и показаны раздельно.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ===== CHART SECTION ===== -->
<section style="background:var(--clr-bg); padding:3rem 0 2rem;">
  <div class="container fade-up">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
      <span id="chartPeriod" class="text-muted small"></span>
      <span class="small" style="color:var(--clr-terra);"><i class="bi bi-exclamation-circle me-1"></i>Данные за сентябрь 2026 не получены</span>
    </div>

    <div class="card-custom p-3 p-md-4" style="border-top:4px solid var(--clr-green); position:relative;">
      <div style="position:relative; height:clamp(320px, 45vw, 520px);">
        <canvas id="sorghumChart" role="img" aria-label="График цен на сорго: Texas FOB недельные, Texas FOB месячное среднее, США цена фермерам NASS"></canvas>
      </div>
      <p class="small text-muted mt-3 mb-0">
        Ряды не склеены: линия рвётся там, где наблюдений нет. Месячные точки (производное среднее и NASS) нанесены на середину месяца. Пропуски не заполняются нулём или интерполяцией.
      </p>
    </div>

    <!-- Карточки по сериям (считаются из данных в JS) -->
    <div class="row g-3 mt-3" id="statsRow"></div>
    <div id="outOfRange"></div>

    <!-- Источники и ограничения -->
    <h2 class="h4 mt-5 mb-3" id="sources"><i class="bi bi-journal-text me-2"></i>Источники и ограничения</h2>
    <div class="table-responsive">
      <table class="table table-bsgro align-middle small">
        <thead>
          <tr>
            <th>Источник</th><th>Что именно взято</th><th>Тип</th><th>Дата публикации / обновления</th><th>Оговорка</th>
          </tr>
        </thead>
        <tbody>
          {% for s in sorghumPrices.sources %}
          <tr>
            <td><a href="{{ s.url }}" target="_blank" rel="noopener noreferrer">{{ s.name }}</a><br><span class="text-muted">{{ s.locator }}</span></td>
            <td>{{ s.taken }}</td>
            <td>{{ typeRu[s.type] or s.type }}</td>
            <td>{{ s.publishedAt or s.lastUpdated or "—" }}{% if s.lastUpdated and not s.publishedAt %} (обновлено){% endif %}</td>
            <td>{{ s.caveat or s.unitCaveat or "—" }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <div class="mt-3 p-3" style="background:var(--clr-bg-alt); border-radius:var(--radius); border-left:4px solid var(--clr-green);">
      <p class="small fw-bold mb-1">Единицы и пересчёт</p>
      <ul class="small mb-0">
        <li><strong>Texas FOB, недельные:</strong> USD/т (метрическая тонна), как опубликовано; индикативные котировки, не сделки и не твёрдые оферты.</li>
        <li><strong>Texas FOB, среднее за месяц:</strong> USD/т; среднее арифметическое доступных недельных котировок. Производный ряд, не независимое измерение; январь 2026 — одно наблюдение.</li>
        <li><strong>США, цена фермерам (NASS):</strong> опубликовано в USD/cwt (1 cwt = 100 фунтов); на графике USD/т = USD/cwt &times; 1000 / (100 &times; 0,45359237). Только арифметический пересчёт единиц. Это не FOB-цена.</li>
      </ul>
    </div>

    <h2 class="h4 mt-5 mb-3" id="not-shown"><i class="bi bi-eye-slash me-2"></i>Не показано на графике и почему</h2>
    <div class="table-responsive">
      <table class="table table-bsgro align-middle small">
        <thead><tr><th>Ряд</th><th>Период</th><th>Точек</th><th>Причина</th></tr></thead>
        <tbody>
          {% for e in sorghumPrices.excluded %}
          <tr>
            <td>{{ e.label }}</td>
            <td>{{ e.periodStart }} … {{ e.periodEnd }}</td>
            <td>{{ e.count }}</td>
            <td>{{ e.reason }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <details class="mt-3 small">
      <summary>Правила обработки данных</summary>
      <ul class="mt-2">
        {% for r in sorghumPrices.meta.rules %}<li>{{ r }}</li>{% endfor %}
      </ul>
      <p class="text-muted">Выгрузка: {{ sorghumPrices.meta.retrievedAt }}. {{ sorghumPrices.meta.september2026Note }}</p>
    </details>

    <div class="mt-4 text-center">
      <a href="/sorgo-project/#strategy" class="btn btn-outline-success me-2"><i class="bi bi-arrow-left me-1"></i>К стратегии</a>
      <a href="/sorgo/#sec1" class="btn btn-outline-primary"><i class="bi bi-book me-1"></i>Глобальный обзор сорго</a>
    </div>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
(function () {
  'use strict';

  var DATA = {{ sorghumPrices | dump | safe }};
  var DAY = 86400000;
  var START = DATA.meta.periodStart; // '2026-01'
  var X_MIN = Date.UTC(+START.split('-')[0], +START.split('-')[1] - 1, 1), X_MAX = Date.UTC(2026, 9, 1); // 2026-01 … конец 2026-09
  function inRange(o) { return (o.date || o.period).slice(0, 7) >= START; }
  var MONTHS = ['янв','фев','мар','апр','май','июн','июл','авг','сен','окт','ноя','дек'];
  var STYLE = {
    texas_fob_indicative_weekly: { color: '#2E7D32', radius: 3.5, dash: [] },
    texas_fob_available_weekly_mids_monthly_mean: { color: '#E07B00', radius: 5, dash: [6, 4] },
    us_nass_sorghum_farm_price_monthly: { color: '#0D3B66', radius: 5, dash: [] }
  };

  function ts(o) {
    if (o.date) { var a = o.date.split('-'); return Date.UTC(+a[0], a[1] - 1, +a[2]); }
    var b = o.period.split('-'); return Date.UTC(+b[0], b[1] - 1, 15); // середина месяца
  }
  function monthIdx(o) { var p = (o.period || o.date).split('-'); return (+p[0]) * 12 + (+p[1]); }

  /* Точки {x,y}; между несмежными наблюдениями вставляется null → линия рвётся */
  function toPoints(s) {
    var pts = [], prev = null;
    s.observations.filter(inRange).forEach(function (o) {
      var t = ts(o);
      var gap = prev === null ? false :
        (s.frequency === 'weekly' ? (t - prev.t) > 10 * DAY : (monthIdx(o) - prev.m) > 1);
      if (gap) pts.push({ x: (prev.t + t) / 2, y: null });
      pts.push({ x: t, y: o.value, o: o });
      prev = { t: t, m: monthIdx(o) };
    });
    return pts;
  }

  function fmt(v) { return '$' + v.toFixed(0); }
  function dateLabel(o) {
    if (o.date) return o.date;
    return o.period;
  }

  /* Подпись «нет данных» над сентябрём 2026 */
  var septPlugin = {
    id: 'septNoData',
    beforeDatasetsDraw: function (chart) {
      var x = chart.scales.x, a = chart.chartArea, c = chart.ctx;
      var x1 = x.getPixelForValue(Date.UTC(2026, 8, 1)), x2 = Math.min(x.getPixelForValue(X_MAX), a.right);
      c.save();
      c.fillStyle = 'rgba(224,123,0,0.08)';
      c.fillRect(x1, a.top, x2 - x1, a.bottom - a.top);
      c.fillStyle = '#8a5a00'; c.font = '11px Montserrat, sans-serif'; c.textAlign = 'right';
      c.fillText('сен 2026: нет данных', x2 - 4, a.top + 14);
      c.restore();
    }
  };

  function renderChart() {
    var datasets = DATA.series.map(function (s) {
      var st = STYLE[s.id] || { color: '#555', radius: 4, dash: [] };
      return {
        label: s.label + ' — ' + s.unit,
        data: toPoints(s),
        parsing: false,
        spanGaps: false,
        showLine: true,
        borderColor: st.color,
        backgroundColor: st.color,
        borderWidth: 2,
        borderDash: st.dash,
        tension: 0,
        pointRadius: st.radius,
        pointHoverRadius: st.radius + 2,
        pointStyle: s.id === 'texas_fob_available_weekly_mids_monthly_mean' ? 'rectRot' : (s.id.indexOf('nass') >= 0 ? 'triangle' : 'circle')
      };
    });

    new Chart(document.getElementById('sorghumChart'), {
      type: 'line',
      data: { datasets: datasets },
      plugins: [septPlugin],
      options: {
        responsive: true,
        maintainAspectRatio: false,
        parsing: false,
        interaction: { mode: 'nearest', intersect: true },
        plugins: {
          legend: { position: 'bottom', labels: { font: { family: 'Montserrat', size: 12 }, usePointStyle: true } },
          tooltip: {
            backgroundColor: 'rgba(13, 59, 102, 0.92)',
            titleFont: { family: 'Montserrat', size: 12 },
            bodyFont: { family: 'Montserrat', size: 13 },
            padding: { x: 14, y: 10 },
            cornerRadius: 8,
            callbacks: {
              title: function (items) { var o = items[0].raw.o; return o ? dateLabel(o) : ''; },
              label: function (ctx) {
                var o = ctx.raw.o, lines = [ctx.dataset.label.split(' — ')[0], '$' + ctx.raw.y.toFixed(1) + ' / т'];
                if (o && o.originalValue != null) lines.push('NASS: ' + o.originalValue + ' USD/cwt');
                if (o && o.measurementCount != null) lines.push('недель в среднем: ' + o.measurementCount + (o.measurementCount === 1 ? ' (одно наблюдение)' : ''));
                return lines;
              }
            }
          }
        },
        scales: {
          x: {
            type: 'linear', min: X_MIN, max: X_MAX,
            grid: { color: 'rgba(0,0,0,0.04)' },
            afterBuildTicks: function (axis) {
              var t = [];
              for (var m = 0; m <= 8; m++) { t.push({ value: Date.UTC(2026, m, 1) }); }
              axis.ticks = t;
            },
            ticks: {
              font: { family: 'Montserrat', size: 11 }, color: '#5A6268', maxRotation: 0,
              callback: function (v) { var d = new Date(v); return MONTHS[d.getUTCMonth()] + ' ' + d.getUTCFullYear(); }
            }
          },
          y: {
            grid: { color: 'rgba(0,0,0,0.04)' },
            ticks: { font: { family: 'Montserrat', size: 11 }, color: '#5A6268', callback: function (v) { return '$' + v; } },
            title: { display: true, text: 'USD за метрическую тонну', font: { family: 'Montserrat', size: 12, weight: '600' }, color: '#5A6268' }
          }
        }
      }
    });
  }

  /* Карточки: макс / мин / последняя — по каждой серии, из данных */
  function renderStats() {
    var row = document.getElementById('statsRow');
    row.innerHTML = '';
    DATA.series.forEach(function (s) {
      var obs = s.observations.filter(function (o) { return o.value != null && inRange(o); });
      if (!obs.length) return;
      var mx = obs[0], mn = obs[0];
      obs.forEach(function (o) { if (o.value > mx.value) mx = o; if (o.value < mn.value) mn = o; });
      var last = obs[obs.length - 1], st = STYLE[s.id] || { color: '#555' };
      var col = document.createElement('div');
      col.className = 'col-12 col-lg-4';
      col.innerHTML =
        '<div class="card-custom p-3 h-100" style="border-top:4px solid ' + st.color + ';">' +
        '<div class="small fw-bold mb-1">' + s.label + '</div>' +
        '<div class="text-muted small mb-2">' + s.unit + ' · точек: ' + obs.length + '</div>' +
        '<div class="d-flex justify-content-between text-center">' +
          '<div><div class="stat-number" style="font-size:1.3rem;">' + fmt(mx.value) + '</div><div class="stat-label">Макс<br>' + dateLabel(mx) + '</div></div>' +
          '<div><div class="stat-number" style="font-size:1.3rem;color:var(--clr-terra);">' + fmt(mn.value) + '</div><div class="stat-label">Мин<br>' + dateLabel(mn) + '</div></div>' +
          '<div><div class="stat-number" style="font-size:1.3rem;color:var(--clr-blue);">' + fmt(last.value) + '</div><div class="stat-label">Последняя<br>' + dateLabel(last) + '</div></div>' +
        '</div></div>';
      row.appendChild(col);
    });
  }

  /* Значения до начала оси графика — не теряем, показываем таблицей */
  function renderOutOfRange() {
    var box = document.getElementById('outOfRange'), rows = '', srcById = {};
    DATA.sources.forEach(function (x) { srcById[x.id] = x; });
    DATA.series.forEach(function (s) {
      s.observations.filter(function (o) { return o.value != null && !inRange(o); }).forEach(function (o) {
        var src = srcById[o.sourceId] || {};
        rows += '<tr><td>' + s.label + '</td><td>' + dateLabel(o) + '</td><td>$' + o.value.toFixed(1) + ' / т</td><td>' +
          (o.originalValue != null ? o.originalValue + ' ' + (o.originalUnit || '') : '—') + '</td><td>' +
          (o.sourceUrl ? '<a href="' + o.sourceUrl + '" target="_blank" rel="noopener">' + (src.name || o.sourceId) + '</a>' : (src.name || o.sourceId)) + '</td></tr>';
      });
    });
    if (!rows) return;
    box.innerHTML = '<h2 class="h4 mt-5 mb-3" id="before-axis"><i class="bi bi-clock-history me-2"></i>Значения вне диапазона графика (до ' + START + ')</h2>' +
      '<p class="text-muted small">Эти наблюдения опубликованы в источнике, но ось графика начинается с ' + START + '. Показаны таблицей, чтобы не терять данные.</p>' +
      '<div class="table-responsive table-bsgro"><table class="table table-striped mb-0"><thead><tr><th>Ряд</th><th>Период</th><th>USD/т</th><th>Исходное значение</th><th>Источник</th></tr></thead><tbody>' + rows + '</tbody></table></div>';
  }

  document.addEventListener('DOMContentLoaded', function () {
    document.getElementById('chartPeriod').textContent =
      'Ось: ' + DATA.meta.periodStart + ' — ' + DATA.meta.periodEnd + ' · последняя доступная точка: ' + DATA.meta.lastAvailablePoint;
    renderChart();
    renderStats();
    renderOutOfRange();
  });
})();
</script>
